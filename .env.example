################################################################################
#                                                                              #
#   APP — the FastAPI application (service: app)                               #
#                                                                              #
################################################################################

APP_NAME=megabot
APP_ENV=local
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=console
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=megabot
APP_DB_PASSWORD=megabot
APP_DB_NAME=megabot
APP_DB_ECHO=false
APP_CORS_ORIGINS=["*"]
APP_EXPOSED_PORT=8000
APP_RUN_MIGRATIONS=true
APP_RUN_SEEDS=false


################################################################################
#                                                                              #
#   POSTGRES — the database (service: postgres)                                #
#                                                                              #
################################################################################

POSTGRES_USER=megabot
POSTGRES_PASSWORD=megabot
POSTGRES_DB=megabot
POSTGRES_EXPOSED_PORT=5432


################################################################################
#                                                                              #
#   PGADMIN — database web UI (service: pgadmin)                               #
#                                                                              #
################################################################################

PGADMIN_EMAIL=admin@megabot.dev
PGADMIN_PASSWORD=megabot
PGADMIN_EXPOSED_PORT=5050


################################################################################
#                                                                              #
#   SIGNAL_API — signal-cli-rest-api (service: signal-api)                     #
#                                                                              #
################################################################################

SIGNAL_API_MODE=native
SIGNAL_API_EXPOSED_HOST=127.0.0.1
SIGNAL_API_EXPOSED_PORT=8080
