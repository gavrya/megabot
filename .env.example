# ---- Application ----
APP_NAME=megabot
APP_ENV=local
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---- Logging ----
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: console (local) | json (deployed)
LOG_FORMAT=console

# ---- Database ----
# Host used when running the app locally (outside Docker).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=megabot
POSTGRES_PASSWORD=megabot
POSTGRES_DB=megabot
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- HTTP ----
CORS_ORIGINS=["*"]

# ---- docker-compose only ----
# Host ports published by docker-compose (leave empty in Coolify/Dokploy: the
# platform's proxy routes to the container port instead).
APP_PORT=8000
POSTGRES_EXPOSED_PORT=5432
PGADMIN_PORT=5050
# pgAdmin web UI login (not the database credentials).
# The domain must be a real TLD: pgAdmin rejects reserved ones like .local and refuses to start.
PGADMIN_EMAIL=admin@megabot.dev
PGADMIN_PASSWORD=megabot
# Where the app container reaches the database inside the compose network.
# Change only when pointing the app at an external database.
DOCKER_POSTGRES_HOST=postgres
DOCKER_POSTGRES_PORT=5432
# Run `alembic upgrade head` (and optionally the seeders) on container start.
RUN_MIGRATIONS=true
RUN_SEEDS=false
