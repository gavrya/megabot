{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install",
      "type": "shell",
      "command": "uv sync",
      "problemMatcher": []
    },
    {
      "label": "run",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "uv run ruff check .",
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "shell",
      "command": "uv run ruff format . && uv run ruff check . --fix",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "uv run pyright",
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "uv run pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test (unit)",
      "type": "shell",
      "command": "uv run pytest tests/unit",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test (integration)",
      "type": "shell",
      "command": "uv run pytest tests/integration",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test (coverage)",
      "type": "shell",
      "command": "uv run pytest --cov --cov-report=term --cov-report=html",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "migrate",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "problemMatcher": []
    },
    {
      "label": "seed",
      "type": "shell",
      "command": "uv run seed",
      "problemMatcher": []
    }
  ]
}
